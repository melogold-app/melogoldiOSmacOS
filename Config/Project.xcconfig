// Общие настройки сборки всех таргетов. project.yml ссылается на этот файл для Debug и Release.
#include "Version.xcconfig"

// Подпись по умолчанию — ad-hoc («Sign to Run Locally»): Mac-сборка запускается локально, симуляторам
// подпись не нужна. Команда разработчика — только в локальном Config/Local.xcconfig (в .gitignore),
// в CI — секрет APPLE_TEAM_ID. На устройство без команды не собрать — так и задумано.
// Таргеты в project.yml берут подпись из этих переменных: свои значения XcodeGen иначе перекрыли бы xcconfig.
MELOGOLD_SIGN_STYLE = Manual
MELOGOLD_SIGN_IDENTITY = -
MELOGOLD_TEAM =

// Публичный ключ EdDSA Sparkle (задание 0004), выпущен 2026-09-30. Закрытый — только в секрете SPARKLE_ED_PRIVATE_KEY
// и в резервной копии у пользователя: потерян — установленные Mac больше не обновятся. Без ключа Mac-сборка не
// проверяет обновления, а scripts/release-macos.sh без --dry-run останавливается.
SPARKLE_PUBLIC_ED_KEY = f88M2GaXBNGG5MGG/5ROs/CffiRQCT1U/bhXm54Tj0A=

#include? "Local.xcconfig"
